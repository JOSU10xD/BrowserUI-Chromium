<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BrowserUISetup.SetupAccess"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowserUISetup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:asset="using:BrowserUIAsset"
    xmlns:ctr="using:CommunityToolkit.WinUI.Controls"
    FontFamily="Segoe UI">

    <Grid>
        <!-- Animated GIF Background -->
        <Image Source="ms-appx:///Assets/80645-572367655 (1).gif"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Overlay Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  VerticalAlignment="Stretch"
                  Canvas.ZIndex="1"
                  ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Margin="5,5,0,5" Source="{asset:ImageLoader ImageName=access.png}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="24"
                           Foreground="White">
                    <Run Text="Accessibility" />
                    <Run CharacterSpacing="2"
                         FontWeight="Light"
                         FontSize="22"
                         Text=" Settings" />
                </TextBlock>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="30">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            MinWidth="370"
                            MinHeight="370"
                            CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/gridlogo.jpg"/>
                        </Border.Background>
                    </Border>


                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical" Spacing="10">

                        <!-- Light Mode Setting -->
                        <ctr:SettingsCard Margin="0,1,0,0">
                            <ctr:SettingsCard.Header>
                                <TextBlock Text="FireBrowser - Light Mode" FontSize="22" Foreground="White"/>
                            </ctr:SettingsCard.Header>
                            <ctr:SettingsCard.Description>
                                <TextBlock Text="This Will Enable Light Mode Or Not (This Will Disable Stuff To Optimize Performance)"
                                           FontSize="18"
                                           Foreground="White"/>
                            </ctr:SettingsCard.Description>
                            <ctr:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xEC4A;" />
                            </ctr:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="LiteMode" Toggled="LiteMode_Toggled"/>
                        </ctr:SettingsCard>

                        <!-- Speech Engine Setting -->
                        <ctr:SettingsCard Margin="0,1,0,0">
                            <ctr:SettingsCard.Header>
                                <TextBlock Text="FireBrowser - SpeakEngine" FontSize="22" Foreground="White"/>
                            </ctr:SettingsCard.Header>
                            <ctr:SettingsCard.Description>
                                <TextBlock Text="Change language of Speech Engine"
                                           FontSize="18"
                                           Foreground="White"/>
                            </ctr:SettingsCard.Description>
                            <ctr:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xEFA9;" />
                            </ctr:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="Langue" SelectionChanged="Langue_SelectionChanged" SelectedItem="en-US" FontSize="18">
                                <x:String>nl-NL</x:String>
                                <x:String>en-US</x:String>
                            </ComboBox>
                        </ctr:SettingsCard>

                        <!-- Setup Button -->
                        <Button Margin="0,20,0,0"
                                Style="{ThemeResource AccentButtonStyle}"
                                Content="Setup Access"
                                Click="Button_Click"
                                FontSize="20"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>