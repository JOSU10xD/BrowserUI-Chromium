<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BrowserUISetup.SetupFinish"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowserUISetup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:asset="using:BrowserUIAsset">

    <Grid>
        <!-- Animated GIF Background -->
        <Image Source="ms-appx:///Assets/89627-614703091_small.gif"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Overlay Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  VerticalAlignment="Stretch"
                  Canvas.ZIndex="1"
                  ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Margin="5,5,0,5" Source="{asset:ImageLoader ImageName=done.png}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White">
                    <Run Text="Finishing " />
                    <Run CharacterSpacing="2"
                         FontWeight="Light"
                         FontSize="26"
                         Text="SETTINGS"/>
                </TextBlock>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ColumnSpacing="30">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True"/>
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Side: Image -->
                    <Border Grid.Column="0"
                            MinWidth="500"
                            MinHeight="400"
                            CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/setup_image.png"/>
                        </Border.Background>
                    </Border>

                    <!-- Right Side: Loading Status in a Box -->
                    <Border Grid.Column="1"
                            Background="#AA000000"  
                            Padding="20"
                            CornerRadius="10"
                            MinWidth="400">
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="10">

                            <!-- Please Wait Message -->
                            <TextBlock Text="Please Wait"
                                       TextWrapping="Wrap"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>

                            <!-- Progress Bar -->
                            <ProgressBar Width="150"
                                         IsEnabled="True"
                                         IsIndeterminate="True"
                                         ShowPaused="False"
                                         ShowError="False"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>