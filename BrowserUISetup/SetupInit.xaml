<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BrowserUISetup.SetupInit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:BrowserUISetup"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:asset="using:BrowserUIAsset"
      FontFamily="Segoe UI">

    <Grid>
        <!-- Animated GIF Background -->
        <Image Source="ms-appx:///Assets/80645-572367655 (1).gif"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Overlay Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  VerticalAlignment="Stretch"
                  Canvas.ZIndex="1"
                  ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Margin="5,5,0,5" Source="{asset:ImageLoader ImageName=Logo.png}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White">
                    <Run Text="GRID"/>
                    <Run CharacterSpacing="2"
                         FontWeight="Light"
                         FontSize="26"
                         Text="ALPHA"/>
                </TextBlock>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ColumnSpacing="30">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True"/>
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Side: Image Border -->
                    <Border Grid.Column="0"
                            MinWidth="400"
                            MinHeight="400"
                            CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/gridlogo.jpg"/>
                        </Border.Background>
                    </Border>

                    <!-- Right Side: Setup Content in a Dark Semi-Transparent Box -->
                    <Border Grid.Column="1"
                            Background="#AA000000"  
                        Padding="20"
                            CornerRadius="10"
                            MinWidth="400">
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="15">

                            <!-- Welcome Message -->
                            <TextBlock Text="Welcome to GRID Browser"
                                       TextWrapping="Wrap"
                                       FontSize="35"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <!-- Description Message -->
                            <TextBlock FontSize="18"
                                       Text="{x:Bind _introMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="White"/>

                            <!-- Setup Button -->
                            <Button Margin="0,20,0,0"
                                    x:Name="Setup"
                                    Click="Setup_Click"
                                    Content="Setup your browser"
                                    FontSize="20"
                                    Padding="10,5"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Frame x:Name="Next"/>
        </Grid>
    </Grid>
</Page>
