<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BrowserUISetup.SetupPrivacy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:BrowserUISetup"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      xmlns:asset="using:BrowserUIAsset"
      xmlns:ctr="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <!-- Animated GIF Background -->
        <Image Source="ms-appx:///Assets/80645-572367655 (1).gif"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Overlay Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  VerticalAlignment="Stretch"
                  Canvas.ZIndex="1"
                  ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="24" Foreground="White">
                    <TextBlock.Inlines>
                        <Run Text="Privacy" FontSize="24"/>
                        <Run CharacterSpacing="2" FontWeight="Light" Text="SETTINGS" FontSize="22"/>
                    </TextBlock.Inlines>
                </TextBlock>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="20">
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ColumnSpacing="30">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True"/>
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Side: Image Border -->
                    <Border Grid.Column="0"
                            MinWidth="420"
                            MinHeight="370"
                            CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/gridlogo.jpg"/>
                        </Border.Background>
                    </Border>

                    <!-- Right Side: Setup Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical" Spacing="15">
                        <ctr:SettingsCard Header="Disable Javascript" 
                                          Description="This improves your privacy by blocking trackers but it can also break a lot sites" 
                                          FontSize="18">
                            <ctr:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE943;"/>
                            </ctr:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="DisableJavaScriptToggle" Toggled="DisableJavaScriptToggle_Toggled"/>
                        </ctr:SettingsCard>

                        <ctr:SettingsCard Header="Disable Genaral AutoFill" 
                                          Description="This will disable autofilling in browser ( No Automaticly Fill )" 
                                          FontSize="18">
                            <ctr:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE8DA;"/>
                            </ctr:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="DisableGenaralAutoFillToggle" Toggled="DisableGenaralAutoFillToggle_Toggled"/>
                        </ctr:SettingsCard>

                        <ctr:SettingsCard Header="Disable Web Messages" 
                                          Description="This will disable Webmessages in browser" 
                                          FontSize="18">
                            <ctr:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE8BD;"/>
                            </ctr:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="DisablWebMessFillToggle" Toggled="DisablWebMessFillToggle_Toggled"/>
                        </ctr:SettingsCard>

                        <ctr:SettingsCard Header="Disable Save Passwords" 
                                          Description="This will disable browser Auto Save Password" 
                                          FontSize="18">
                            <ctr:SettingsCard.HeaderIcon>
                                <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xF427;"/>
                            </ctr:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="PasswordWebMessFillToggle" Toggled="PasswordWebMessFillToggle_Toggled"/>
                        </ctr:SettingsCard>

                        <Button Margin="0,20,0,0"
                                Style="{ThemeResource AccentButtonStyle}"
                                Content="Setup Privacy"
                                Click="Button_Click"
                                FontSize="18"/>
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>